Subject: [PATCH 1/1] Delete Getty Service for auto login

---
 meta/recipes-core/systemd/systemd_255.17.bb    |  2 ++
 .../python/python3/python3-manifest.json       | 18 ++++++++++++++++++
 2 files changed, 20 insertions(+)

diff --git a/meta/recipes-core/systemd/systemd_255.17.bb b/meta/recipes-core/systemd/systemd_255.17.bb
index 8f5170929f..71d7520086 100644
--- a/meta/recipes-core/systemd/systemd_255.17.bb
+++ b/meta/recipes-core/systemd/systemd_255.17.bb
@@ -404,6 +404,8 @@ do_install() {
 	if [ -e ${D}${nonarch_libdir}/tmpfiles.d/legacy.conf ];then
 		sed -i -e '/^L \/var\/log\/README/d' ${D}${nonarch_libdir}/tmpfiles.d/legacy.conf
 	fi
+        rm -rf ${D}${rootlibexecdir}/systemd/system/getty.target.wants/getty@.service
+        rm -rf ${D}/usr/lib/systemd/system/getty@.service
 }
 
 python populate_packages:prepend (){
